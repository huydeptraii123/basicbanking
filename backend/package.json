{
  "name": "basicbanking-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js",
    "test": "jest --runInBand",
    "load-test:prepare": "ts-node tests/load/transfer/prepare-test-data.ts --",
    "load-test:100": "artillery run tests/load/transfer/transfer-100.yml",
    "load-test:1000": "artillery run tests/load/transfer/transfer-1000.yml",
    "load-test:results": "ts-node tests/load/transfer/view-test-results.ts",
    "load-test:auto": "powershell -Command \"npm run load-test:1000 | Tee-Object temp.txt; Get-Content temp.txt | .\\tests\\load\\parse-results.ps1; Remove-Item temp.txt\"",
    "load-test:auto:100": "powershell -Command \"npm run load-test:100 | Tee-Object temp.txt; Get-Content temp.txt | .\\tests\\load\\parse-results.ps1; Remove-Item temp.txt\"",
    "load-test:auto:1000": "powershell -Command \"npm run load-test:1000 | Tee-Object temp.txt; Get-Content temp.txt | .\\tests\\load\\parse-results.ps1; Remove-Item temp.txt\"",
    "load-test:signin:prepare": "ts-node tests/load/sign-in/prepare-test-data.ts",
    "load-test:signin:100": "artillery run tests/load/sign-in/signin-100.yml",
    "load-test:signin:1000": "artillery run tests/load/sign-in/signin-1000.yml",
    "load-test:signin:results": "ts-node tests/load/sign-in/view-results.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "@sentry/nextjs": "^10.25.0",
    "@sentry/node": "^10.25.0",
    "@sentry/profiling-node": "^10.25.0",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.0",
    "lowdb": "^6.0.1",
    "otplib": "^12.0.1",
    "plaid": "^23.0.0",
    "qrcode": "^1.5.4",
    "systeminformation": "^5.27.11",
    "uuid": "^9.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.1",
    "artillery": "^2.0.0-31",
    "jest": "^29.0.0",
    "prisma": "^5.8.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
